# Server-only Gemini key. Set the real value in the ignored root .env.
# Restart npm run dev after changing .env; verify with npm run ai:check.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Reserved for future use; not consumed by the Phase 0 application.
APP_URL="MY_APP_URL"

# NODE_ENV=production serves the built frontend; otherwise Vite middleware is used.
# PORT defaults to 3000. No background scheduler or job connector is configured.

# PostgreSQL only. Runtime may use Neon pooling; migrations require the direct endpoint.
# Never put these server-side secrets in VITE_* variables.
DATABASE_URL=""
DATABASE_MIGRATION_URL=""
# HOST defaults to 127.0.0.1. Only override with appropriate private-network protection.
